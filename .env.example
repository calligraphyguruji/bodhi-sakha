# Server secrets: set in Vercel Project Settings → Environment Variables.
# Never prefix a secret with VITE_. All blank values below are placeholders.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b

# Required in production for accounts, history, memory, uploads and shared rate limits.
# Use a pooled PostgreSQL URL and the provider's verified TLS parameters.
DATABASE_URL=
JWT_SECRET=

# Required for direct uploads above 3 MB (up to the existing 15 MB limit).
# Connect a PRIVATE Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Optional image-generation override; defaults to GEMINI_API_KEY.
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image

# Local development ONLY. Never set ALLOW_LOCAL_DB in production.
# Leave false when using PostgreSQL. Local JSON is not production persistence.
ALLOW_LOCAL_DB=false
# LOCAL_DATA_DIR=/absolute/path/to/development-data

# Optional vision overrides; independent of text-only model choices.
# Defaults verified against official provider docs on 2026-10-25.
GEMINI_VISION_MODEL=gemini-3.8-flash
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional tighter image limit in bytes; capped at 2097152 (2 MiB).
MAX_IMAGE_BYTES=2097152
